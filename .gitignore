
### `.gitignore`

```gitignore
# ==============================
# Operating System Files
# ==============================

.DS_Store
Thumbs.db
desktop.ini


# ==============================
# Editor  IDE Files
# ==============================

.vscode
.idea
.iml


# ==============================
# JavaScript  Node
# ==============================

node_modules
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log


# ==============================
# Environment  Secret Files
# ==============================

.env
.env.
!.env.example


# ==============================
# Logs
# ==============================

.log


# ==============================
# Temporary Files
# ==============================

.tmp
.temp
.swp
.swo


# ==============================
# Build  Generated Files
# ==============================

dist
build
coverage


# ==============================
# Python Cache (if used later)
# ==============================

__pycache__
.py[cod]
.venv
venv